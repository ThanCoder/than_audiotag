### export TOOLCHAIN="$NDK/toolchains/llvm/prebuilt/linux-x86_64"


export NDK="$ANDROID_NDK_HOME"
export API=24
export TOOLCHAIN="$NDK/build/cmake/android.toolchain.cmake"


TAGLIB_DST_DIR="build/android-arm64"
TAGLIB_NAME="libthan_audiotag.so"

cmake -B $TAGLIB_DST_DIR \
  -DCMAKE_TOOLCHAIN_FILE=$TOOLCHAIN \
  -DANDROID_ABI=arm64-v8a \
  -DANDROID_PLATFORM=android-21 \
  -DCMAKE_BUILD_TYPE=MinSizeRel \
  -DBUILD_SHARED_LIBS=OFF \
  -DBUILD_BINDINGS=ON \
  -DBUILD_TESTING=OFF \
  -DBUILD_EXAMPLES=OFF \
  -DCMAKE_C_FLAGS="-fPIC -Os -ffunction-sections -fdata-sections" \
  -DCMAKE_CXX_FLAGS="-fPIC -Os -ffunction-sections -fdata-sections"

cmake --build $TAGLIB_DST_DIR --config Release
cmake --build $TAGLIB_DST_DIR -j$(nproc)

cmake --install $TAGLIB_DST_DIR --config Release --prefix "$TAGLIB_DST_DIR/dist"
cmake --install $TAGLIB_DST_DIR --config Release --prefix "$TAGLIB_DST_DIR/dist" --strip

DIST="$(pwd)/$TAGLIB_DST_DIR/dist"
OUTPUT_LIB="$(pwd)/$TAGLIB_DST_DIR/dist/$TAGLIB_NAME"

$ANDROID_NDK_HOME/toolchains/llvm/prebuilt/linux-x86_64/bin/clang++ \
  --target=aarch64-linux-android21 \
  -shared \
  -Wl,--whole-archive \
  "$DIST/lib/libtag_c.a" \
  "$DIST/lib/libtag.a" \
  -Wl,--no-whole-archive \
  -lz \
  -o $OUTPUT_LIB


$ANDROID_NDK_HOME/toolchains/llvm/prebuilt/linux-x86_64/bin/llvm-strip \
  --strip-unneeded $OUTPUT_LIB


ls -lh $OUTPUT_LIB

nm -D --defined-only $OUTPUT_LIB | grep tag_